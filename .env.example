# Fill only the vendors you use. Empty keys are ignored.
# See GET /v1/providers for the full built-in list.

ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
FIREWORKS_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OLLAMA_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=

# Optional: pin which two vendors seed/demo use. If empty, the gateway
# picks the first two vendors that have keys set.
GATEWAY_PRIMARY_PROVIDER=
GATEWAY_PRIMARY_MODEL=
GATEWAY_SECONDARY_PROVIDER=
GATEWAY_SECONDARY_MODEL=

# Register a vendor that is not in the built-in catalog (key stays in its own env var).
# EXTRA_PROVIDERS_JSON={"myvendor":{"base_url":"https://api.example.com/v1","api_key_env":"MYVENDOR_API_KEY","example_model":"their-model"}}
EXTRA_PROVIDERS_JSON=

DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
